{
  "name": "unity-call",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npx vite",
    "dev:server": "node --experimental-strip-types --watch server/src/index.ts",
    "build": "npx vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "preview": "npx vite preview",
    "test": "node --experimental-strip-types server/src/selfcheck.ts",
    "test:security": "node --experimental-strip-types --test server/src/security.test.ts server/src/http.test.ts server/src/guest.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "framer-motion": "^11.5.4",
    "i18next": "^24.2.0",
    "lucide-react": "0.522.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "latest",
    "concurrently": "^9.1.2",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.5.4",
    "vite": "^6.4.5"
  }
}
